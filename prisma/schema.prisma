generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  fullName        String
  phone           String   @unique
  email           String?  @unique
  bvn             String?  @unique
  nin             String?  @unique
  password        String?
  pin             String   @default("")
  transactionPin  String   @default("")
  appPin          String?
  dateOfBirth     String?
  country         String?  @default("Nigeria")
  trustScore      Float    @default(50)
  role            Role     @default(CONTRIBUTOR)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  pushToken       String?
  referralCode    String?  @unique
  referralCount   Int      @default(0)
  referredBy      String?
  providusAccountNumber String? @unique
  providusAccountName   String?
  providusReference     String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet          Wallet?
  ajoMembers      AjoMember[]
  defaultRecords  DefaultRecord[]
  savingsGoals    SavingsGoal[]
}

enum Role {
  CONTRIBUTOR
  AGENT
  ADMIN
  PLATFORM
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  balance      Float         @default(0)
  totalSaved   Float         @default(0)
  totalPayout  Float         @default(0)
  isLocked     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  type        TransactionType
  amount      Float
  balance     Float
  description String
  reference   String            @unique
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  wallet      Wallet            @relation(fields: [walletId], references: [id])
  latitude        Float?
  longitude       Float?
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model AjoGroup {
  id                  String      @id @default(uuid())
  name                String
  amount              Float
  frequency           Frequency
  totalMembers        Int
  currentCycle        Int         @default(0)
  isActive            Boolean     @default(true)
  isGuaranteed        Boolean     @default(false)
  guaranteeFee        Float       @default(0)
  guaranteePoolBalance Float      @default(0)
  avatarCoveredCount  Int         @default(0)
  maxAvatarCoverage   Int         @default(2)
  createdBy           String
  startDate           DateTime?
  nextPayoutDate      DateTime?
  nextDueDate         DateTime?
  inviteCode          String?     @unique
  approvalStatus      String      @default("DRAFT")
  approvedAt          DateTime?
  approvedBy          String?
  rejectionReason     String?
  isUserCreated       Boolean     @default(false)
  createdAt           DateTime    @default(now())

  members             AjoMember[]
  cycles              AjoCycle[]
  defaultRecords      DefaultRecord[]
}

model AjoMember {
  id              String      @id @default(uuid())
  groupId         String
  userId          String
  position        Int?
  hasPaid         Boolean     @default(false)
  isAvatar        Boolean     @default(false)
  payoutReceived  Boolean     @default(false)
  joinedAt        DateTime    @default(now())
  lastRemindedCycle Int?
  lastRemindedStage String?
  status          String      @default("APPROVED")
  requestedAt     DateTime?

  group           AjoGroup    @relation(fields: [groupId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@unique([groupId, position])
}

model AjoCycle {
  id              String      @id @default(uuid())
  groupId         String
  cycleNumber     Int
  recipientId     String
  totalAmount     Float
  avatarCovered   Boolean     @default(false)
  avatarAmount    Float       @default(0)
  status          CycleStatus @default(PENDING)
  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  group           AjoGroup    @relation(fields: [groupId], references: [id])
}

enum CycleStatus {
  PENDING
  ACTIVE
  COMPLETED
  PAUSED
}

model DefaultRecord {
  id              String        @id @default(uuid())
  groupId         String
  userId          String
  cycleNumber     Int
  amountOwed      Float
  penaltyAmount   Float         @default(0)
  avatarCovered   Boolean       @default(true)
  recoveryStatus  RecoveryStatus @default(PENDING)
  gracePeriodEnd  DateTime
  createdAt       DateTime      @default(now())
  recoveredAt     DateTime?

  group           AjoGroup      @relation(fields: [groupId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

enum RecoveryStatus {
  PENDING
  SOFT_RECOVERY
  HARD_RECOVERY
  RECOVERED
  WRITTEN_OFF
}

model GuaranteePool {
  id              String   @id @default(uuid())
  totalBalance    Float    @default(0)
  totalCollected  Float    @default(0)
  totalPaidOut    Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SavingsGoal {
  id              String          @id @default(uuid())
  userId          String
  title           String
  description     String?
  goalAmount      Float
  currentAmount   Float           @default(0)
  autoDebitAmount Float           @default(0)
  autoDebitFreq   Frequency?
  autoDebitDay    Int?
  lastAutoDebitAt DateTime?
  maturityNotifiedAt DateTime?
  targetDate      DateTime
  isLocked        Boolean         @default(true)
  isCompleted     Boolean         @default(false)
  isActive        Boolean         @default(true)
  penaltyPercent  Float           @default(5)
  status          SavingsStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  contributions   SavingsContribution[]
}

model SavingsContribution {
  id          String      @id @default(uuid())
  goalId      String
  amount      Float
  type        SavingsContributionType
  description String?
  createdAt   DateTime    @default(now())

  goal        SavingsGoal @relation(fields: [goalId], references: [id])
}

enum SavingsStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  CANCELLED
}

enum SavingsContributionType {
  MANUAL
  AUTO_DEBIT
  WITHDRAWAL
  PENALTY
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}